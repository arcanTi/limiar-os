# Use URL-safe hex because Compose also places this value in the connection URL:
# openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
LIMIAR_GM_USER=mestre
# Leave empty to have a random master access token generated on first boot and
# printed once to the server log; set it to pin a token you already know.
# Exactly 6 characters of 23456789ABCDEFGHJKMNPQRSTUVWXYZ, or it is ignored.
LIMIAR_MASTER_TOKEN=
LIMIAR_PORT=8765

# --- Native run (run-local.sh) -------------------------------------------
# Only needed when running `./run-local.sh` instead of `./run.sh` (Compose).
# Compose derives LIMIAR_DATABASE_URL from POSTGRES_PASSWORD; `python3
# server.py` does not, so the native run needs it spelled out. Startup fails
# when it is missing — the server never silently falls back to a local file.
LIMIAR_DATABASE_URL=postgresql://limiar:replace-with-the-dev-password@127.0.0.1:55433/limiar
# Bind address and port of the native run. Keep 127.0.0.1 unless other machines
# on the table's network must reach the server.
HOST=127.0.0.1
PORT=8765
