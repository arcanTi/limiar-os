# Use URL-safe hex because Compose also places this value in the connection URL:
# openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
LIMIAR_GM_USER=mestre
# Leave empty to have a random master access token generated on first boot and
# printed once to the server log; set it to pin a token you already know.
LIMIAR_MASTER_TOKEN=
LIMIAR_PORT=8765
