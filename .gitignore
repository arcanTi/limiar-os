# SQLite database + WAL/SHM sidecars — runtime state, never versioned
data/*.db
data/*.db-wal
data/*.db-shm
# Pre-rotation backups: same password hashes as the live DB, same rules
data/*.db.bak-*

# User uploads (portraits etc.) — runtime data
uploads/

# Python bytecode cache
__pycache__/
*.py[cod]

# Scratch / temp
tmp/
.pytest_cache/
.ruff_cache/
.vite/
.docx-qa/

# Deployment secrets
.env
.env.*
!.env.example

# OS noise
.DS_Store

# Local assistant tooling — never part of the product repository
.agents/
skills-lock.json
.claude/

# Generated codebase-analysis output
graphify-out/

# Node deps (frontend build tooling)
node_modules/
frontend/node_modules/
frontend/coverage/

# Frontend build output — generated by Vite in containers and CI
dist/
tailwind-sheet.css
